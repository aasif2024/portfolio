# Client Configuration (.env)
# Copy this file to .env and fill in your actual values.

# For local development: Leave blank so Vite proxies /api to http://localhost:5000
# For production (Vercel): Set to your deployed Render API URL, e.g. https://portfolio-api-xxxx.onrender.com
VITE_API_URL=https://your-render-api-url.onrender.com
