# Server Configuration (.env)
# Copy this file to .env and fill in your actual values.

# Port the Express API server listens on (Render sets PORT automatically)
PORT=5000

# MongoDB connection string
# Local MongoDB: mongodb://127.0.0.1:27017/portfolio
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/portfolio?retryWrites=true&w=majority

# Allowed frontend origin(s) for CORS (comma-separated, or set your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.vercel.app
